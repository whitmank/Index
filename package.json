{
  "name": "index",
  "productName": "Index",
  "version": "0.7.0",
  "description": "A personal semantic layer over files and URLs",
  "private": true,
  "type": "module",
  "author": "Karter Whitman",
  "license": "ISC",
  "main": "app/backend/dist/main.js",
  "workspaces": [
    "app/database",
    "app/item-modeler",
    "app/backend",
    "app/frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:db": "npm run test --workspace=@index/database",
    "test:modeler": "npm run test --workspace=@index/item-modeler",
    "test:backend": "npm run test --workspace=@index/backend",
    "test:frontend": "npm run test --workspace=@index/frontend",
    "test": "npm run test:db && npm run test:modeler && npm run test:backend && npm run test:frontend",
    "eval": "npm run eval --workspace=@index/item-modeler"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^39.2.7",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "node-llama-cpp@3.20.0": true,
    "sharp@0.34.5": true
  }
}
