{
  "name": "index-rebuild",
  "productName": "Index",
  "version": "0.6.0",
  "description": "Personal semantic layer over files and URLs",
  "main": "electron/main/index.js",
  "type": "module",
  "scripts": {
    "electron:dev": "node scripts/electron-dev.js",
    "index": "node scripts/electron-dev.js",
    "index:independent": "bash scripts/launch-independent.sh",
    "electron:build": "electron-builder",
    "build": "vite build"
  },
  "keywords": [
    "indexing",
    "database"
  ],
  "author": "Karter Whitman",
  "license": "ISC",
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-ease": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "surrealdb": "^1.3.2",
    "uuid": "^13.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-devtools-installer": "^4.0.0",
    "playwright-core": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.index.app",
    "productName": "Index",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/main/**/*",
      "electron/preload/**/*",
      "dist/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
